<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Show the app's folder in the Files app (On My iPhone → yuuricloud) and in Finder's file
	     sharing, so music can be copied into it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Keep playing with the screen locked or another app open. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- yuuricloud:// links open the app: the computer's QR code and the SoundCloud sign-in. The
	     deep-link plugin adds this from its build script too, but a cached build skips that. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>cloud.yuuri.player.yuuricloud</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yuuricloud</string>
			</array>
		</dict>
	</array>
	<!-- Copying songs from, and remote-controlling, yuuricloud on a computer on the same Wi-Fi. -->
	<key>NSCameraUsageDescription</key>
	<string>yuuricloud uses the camera to scan the QR codes yuuricloud on your computer shows, to pair with it or sign in to SoundCloud.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>yuuricloud connects to yuuricloud on your computer to copy music and to work as a remote.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
